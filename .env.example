# Copy this file to .env and fill in your values.
#   Windows: copy .env.example .env
#   macOS/Linux: cp .env.example .env
#
# .env is listed in .gitignore and should never be published or shared.
# Treat CANVAS_TOKEN and SMTP_PASSWORD like passwords.
#
# Values you set here override config.ini. Leave a value blank if you want
# the setting in config.ini to be used instead.

CANVAS_BASE_URL=https://yourschool.instructure.com
CANVAS_TOKEN=

# Optional email (off unless EMAIL_ENABLED is true).
# The SMTP password is stored only in this file or the environment,
# never in config.ini.
EMAIL_ENABLED=
EMAIL_TO=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USE_TLS=
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional printing (off unless PRINT_ENABLED is true).
# Leave PRINTER_NAME blank to use the system default printer.
PRINT_ENABLED=
PRINTER_NAME=
PRINT_COPIES=
